\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Pipeline (simplified causal flow). A frozen decoder is probed at a \emph  {predefined sparse} candidate grid $\{L/4,L/2,3L/4,L\}$ ($=\{3,6,9,12\}$ for $L{=}12$); the shallowest depth within $\epsilon $ of the best probe accuracy is selected \emph  {a priori} as the candidate pruning depth. The backbone is then truncated to that depth and fine-tuned with a linear intent head over the pooled final state and a token-level slot head (softmax or CRF). No autoregressive decoding at inference. A separate dense sweep (layers $1{-}L$) is used diagnostically in \cref  {sec:results} to test the rule's limits and expose the gap between linear accessibility and fine-tuning sufficiency.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{3}{Pipeline (simplified causal flow). A frozen decoder is probed at a \emph {predefined sparse} candidate grid $\{L/4,L/2,3L/4,L\}$ ($=\{3,6,9,12\}$ for $L{=}12$); the shallowest depth within $\epsilon $ of the best probe accuracy is selected \emph {a priori} as the candidate pruning depth. The backbone is then truncated to that depth and fine-tuned with a linear intent head over the pooled final state and a token-level slot head (softmax or CRF). No autoregressive decoding at inference. A separate dense sweep (layers $1{-}L$) is used diagnostically in \cref {sec:results} to test the rule's limits and expose the gap between linear accessibility and fine-tuning sufficiency}{figure.1}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][]1}{[1][2][]3}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Datasets. Intent-only benchmarks stress fine-grained classification (150 and 77 classes); slot-filling benchmarks stress structured output. All are public; train and test sizes are shown. Counts are measured directly from the exact files our pipeline loads (matching \texttt  {n\_train}/\texttt  {n\_test} in every released result JSON), not copied from prior papers; our ATIS and SNIPS mirrors differ slightly from other commonly-cited reformattings of these benchmarks (e.g.\ ATIS is often cited at 4{,}478 train / 893 test elsewhere in the literature). ATIS \#Slots (135) is the current BIO tag-label count (both B-/I- registered per observed slot type); the M1 encoder/generative baseline runs reported in \S  \ref {sec:results} were produced immediately before this tag-vocabulary convention was adopted and used 101 labels for that run only, which does not affect their reported accuracy/F1 figures.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:datasets}{{1}{3}{Datasets. Intent-only benchmarks stress fine-grained classification (150 and 77 classes); slot-filling benchmarks stress structured output. All are public; train and test sizes are shown. Counts are measured directly from the exact files our pipeline loads (matching \texttt {n\_train}/\texttt {n\_test} in every released result JSON), not copied from prior papers; our ATIS and SNIPS mirrors differ slightly from other commonly-cited reformattings of these benchmarks (e.g.\ ATIS is often cited at 4{,}478 train / 893 test elsewhere in the literature). ATIS \#Slots (135) is the current BIO tag-label count (both B-/I- registered per observed slot type); the M1 encoder/generative baseline runs reported in \S \ref {sec:results} were produced immediately before this tag-vocabulary convention was adopted and used 101 labels for that run only, which does not affect their reported accuracy/F1 figures}{table.1}{}}
\newlabel{tab:datasets@cref}{{[table][1][]1}{[1][3][]3}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Main comparison on ATIS. The pruned discriminative model is $\sim $70$\times $ faster than the generative baseline, matches encoder intent accuracy, and never emits a malformed output.}}{4}{table.2}\protected@file@percent }
