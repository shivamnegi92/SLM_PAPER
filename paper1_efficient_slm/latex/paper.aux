\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Dense per-layer token-level BIO-tag probe (frozen backbone; linear probe validation accuracy \%). ATIS and MASSIVE saturate at L1--L2 and are flat thereafter; SNIPS shows a $+7$pt L1$\to $L2 jump that mirrors the downstream depth-1 slot F1 degradation in \cref  {tab:d1vsd3}. ATIS and MASSIVE do not exhibit an analogous L1$\to $L2 transition.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:slotprobe}{{3}{5}{Dense per-layer token-level BIO-tag probe (frozen backbone; linear probe validation accuracy \%). ATIS and MASSIVE saturate at L1--L2 and are flat thereafter; SNIPS shows a $+7$pt L1$\to $L2 jump that mirrors the downstream depth-1 slot F1 degradation in \cref {tab:d1vsd3}. ATIS and MASSIVE do not exhibit an analogous L1$\to $L2 transition}{table.3}{}}
\newlabel{tab:slotprobe@cref}{{[table][3][]3}{[1][5][]5}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Dense per-layer frozen probe (intent accuracy \%), all five datasets, layers 1--12. Bold denotes the maximum probe accuracy within each dataset (ties bolded); layer 1 is competitive or best on every dataset.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:denseprobe}{{4}{5}{Dense per-layer frozen probe (intent accuracy \%), all five datasets, layers 1--12. Bold denotes the maximum probe accuracy within each dataset (ties bolded); layer 1 is competitive or best on every dataset}{table.4}{}}
\newlabel{tab:denseprobe@cref}{{[table][4][]4}{[1][5][]5}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Depth-1 vs.\ depth-2 vs.\ depth-3 fine-tuning under the matched training-data protocol, capped at 5{,}000 examples per dataset (seed 42). Depth 2 is within 1.73pt of depth 3 on intent across all five datasets; SNIPS slot F1 is the only sizable residual gap. Frozen-probe accessibility at layer 1 does not imply fine-tuning sufficiency at depth 1.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:d1vsd3}{{5}{6}{Depth-1 vs.\ depth-2 vs.\ depth-3 fine-tuning under the matched training-data protocol, capped at 5{,}000 examples per dataset (seed 42). Depth 2 is within 1.73pt of depth 3 on intent across all five datasets; SNIPS slot F1 is the only sizable residual gap. Frozen-probe accessibility at layer 1 does not imply fine-tuning sufficiency at depth 1}{table.5}{}}
\newlabel{tab:d1vsd3@cref}{{[table][5][]5}{[1][5][]6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Frozen intent probe accuracy across backbone depth. On the predefined sparse candidate grid, probe performance is already saturated at depth 3, motivating depth 3 as an aggressive candidate pruning point before fine-tuning. The dense diagnostic sweep shows that linear accessibility emerges even earlier, but downstream experiments (\cref  {sec:results}) demonstrate that accessibility alone does not imply fine-tuning sufficiency.}}{6}{figure.2}\protected@file@percent }
